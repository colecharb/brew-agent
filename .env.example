# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# Supabase: the app's anon key, plus credentials for a real user account.
# The agent signs in as that user and reads at exactly the app's own privilege
# level. No service-role key is used anywhere in this directory, and nothing
# here ever writes to the database.
SUPABASE_URL=
SUPABASE_ANON_KEY=
BREW_AGENT_EMAIL=
BREW_AGENT_PASSWORD=

# Anthropic API key for the LLM arms (the `rules` baseline needs none).
ANTHROPIC_API_KEY=

# Optional overrides.
# BREW_AGENT_MODEL=claude-opus-5
# BREW_AGENT_EFFORT=high          # low | medium | high | xhigh | max
# BREW_AGENT_MAX_ITERATIONS=6
# BREW_AGENT_LABEL_CONCURRENCY=8  # notes labelled in parallel; lower on 429s
# BREW_AGENT_EVAL_CONCURRENCY=6   # pairs evaluated in parallel
#
# Not every model takes every setting. Smaller models have no effort parameter
# at all and reject it; the run drops it and says so rather than failing, but a
# run without effort is not comparable to one with it. Nothing here sets
# `thinking`, so each model does whatever it defaults to — which differs by
# model, and is the main reason two models' numbers may not be like-for-like.
