# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# Supabase: the app's anon key, plus credentials for a real user account.
# The agent signs in as that user and reads at exactly the app's own privilege
# level. No service-role key is used anywhere in this directory, and nothing
# here ever writes to the database.
SUPABASE_URL=
SUPABASE_ANON_KEY=
BREW_AGENT_EMAIL=
BREW_AGENT_PASSWORD=

# The key for whichever provider serves BREW_AGENT_MODEL. Only that one is
# needed — the `rules` baseline needs neither.
COHERE_API_KEY=
# ANTHROPIC_API_KEY=

# Optional overrides.
# BREW_AGENT_MODEL=command-r7b-12-2024
# BREW_AGENT_PROVIDER=cohere      # anthropic | cohere; inferred from the name
# BREW_AGENT_LABEL_MODEL=         # the labelling pass only; defaults to the above
# BREW_AGENT_MAX_TOKENS=          # defaults: 4000 on Cohere, 16000 on Anthropic
# BREW_AGENT_EFFORT=high          # low | medium | high | xhigh | max (Anthropic)
# BREW_AGENT_MAX_ITERATIONS=6
# BREW_AGENT_LABEL_CONCURRENCY=8  # notes labelled in parallel; lower on 429s
# BREW_AGENT_EVAL_CONCURRENCY=6   # pairs evaluated in parallel
#
# The provider follows from the model name — `claude-*` is Anthropic,
# `command-*` and `north-*` are Cohere — and BREW_AGENT_PROVIDER overrides that
# for anything the prefixes don't know. A name it cannot place fails at startup
# rather than authenticating against the wrong API.
#
# Not every model takes every setting. `effort` is Anthropic's; smaller models
# there reject it, and the run drops it and says so rather than failing, but a
# run without effort is not comparable to one with it. On Cohere it is not sent
# at all. Nothing here sets `thinking` either way, so each model does whatever
# it defaults to — which differs by model, and is the main reason two models'
# numbers may not be like-for-like.
#
# max_tokens is a ceiling, not a target: Command R7B rejects a request above
# 4000, and Claude counts thinking against the same budget. The longest answer
# this harness produces is a few hundred tokens.
